    <string name="intro">クイック設定パネルから、普段は設定アプリを開かないと触れない項目をワンタップで操作するためのツールです。各機能の状態を下で確認し、必要なら権限を付与してください。</string>

    <string name="status_available">利用可能</string>
    <string name="status_needs_permission">権限不足</string>
    <string name="status_unsupported">この端末では非対応</string>
    <string name="status_bullet">● %1$s</string>
    <string name="usb_current">● %1$s  (現在: %2$s)</string>
    <string name="timeout_current">現在: %1$s</string>
