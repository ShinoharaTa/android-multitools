    <string name="alarm_not_found">アラーム一覧を開けるアプリが見つかりませんでした</string>

    <string name="section_usb_debug">1. USB デバッグ ON/OFF</string>
    <string name="section_screen_timeout">2. 画面タイムアウト切替</string>
    <string name="section_alarm">3. アラーム画面を開く</string>
    <string name="section_tiles">クイック設定への追加</string>
    <string name="section_widget">ホーム画面ウィジェット</string>
