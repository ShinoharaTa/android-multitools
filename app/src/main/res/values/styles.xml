<?xml version="1.0" encoding="utf-8"?>
<!--
  画面の部品のスタイル。寸法は dimens.xml、色は colors.xml から取る。

  文字サイズは役割で 6 段階だけ。
    ScreenTitle 26 / CardTitle 18 / Lead 16 / Body 14 / FieldLabel・Caption 12
  時刻や残り時間のように大きく見せる数字だけは各画面で決めてよい。
-->
<resources>

    <!-- ===== 画面とカード ===== -->

    <!-- 画面のいちばん外側。左右と上下に space_l。 -->
    <style name="Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/space_l</item>
    </style>

    <style name="Card">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_l</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
    </style>

    <!-- ホーム画面のカード。カード全体がタップ先なのでリップルを付ける。 -->
    <style name="HomeCard" parent="Card">
        <item name="android:foreground">@drawable/ripple_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="HomeCardHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <!-- ===== 文字 ===== -->

    <style name="ScreenTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_m</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <!-- ホームのカード見出し。左にアイコン、右に › が付く。 -->
    <style name="HomeCardTitle" parent="CardTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:drawablePadding">@dimen/space_m</item>
        <item name="android:drawableTint">@color/primary</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="HomeCardChevron">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">›</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- 目立たせたい 1 行 (「次は 明日 7:00」など)。 -->
    <style name="Lead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
    </style>

    <!-- 状態の 1 行 (「● 利用可能」)。色はコードで付ける。 -->
    <style name="StatusLine" parent="Lead">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <!-- 入力欄の直前のラベル。入力欄とくっつけるので下は space_xs、上は前の欄から space_m 空ける。 -->
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:paddingTop">@dimen/space_m</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
    </style>

    <style name="Caption" parent="Body">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CodeBlock">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_code</item>
        <item name="android:padding">@dimen/space_m</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <!-- ===== ボタン =====
      Filled: 1 画面に 1 つ、いちばんやりたい操作 (保存、追加、停止)
      Tonal : 既定。それ以外のふつうの操作
      Text  : キャンセル、削除、補助的な選択
    -->
    <style name="Button" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Button.Tonal">
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/on_secondary_container</item>
    </style>

    <style name="Button.Filled">
        <item name="android:background">@drawable/btn_filled</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="Button.Text">
        <item name="android:background">@drawable/btn_text</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
    </style>

    <!-- 鳴動画面とタイマーの開始のような、大きく押させたいボタン。 -->
    <style name="Button.Filled.Large">
        <item name="android:minHeight">@dimen/button_large</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Button.Tonal.Large">
        <item name="android:minHeight">@dimen/button_large</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
