<?xml version="1.0" encoding="utf-8"?>
<!--
  ホーム画面。やりたいこと (アラームを掛ける / タイマーを始める) に最短で届くことを優先し、
  説明文は置かない。タイルやウィジェットの設定と権限はツール画面に寄せてある。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <TextView
            style="@style/ScreenTitle"
            android:text="@string/app_name" />

        <!-- 許可が足りないときだけ出る注意書き。タップでツール画面へ。 -->
        <TextView
            android:id="@+id/homePermBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_warn"
            android:foreground="?android:attr/selectableItemBackground"
            android:padding="@dimen/space_l"
            android:text="@string/home_perm_banner"
            android:textColor="@color/status_warn"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- アラーム -->
        <LinearLayout
            android:id="@+id/homeAlarmCard"
            style="@style/HomeCard">

            <LinearLayout style="@style/HomeCardHeader">

                <TextView
                    style="@style/HomeCardTitle"
                    android:drawableStart="@drawable/ic_tile_alarm"
                    android:text="@string/alarm_list_title" />

                <TextView
                    style="@style/HomeCardChevron" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeAlarmNext"
                style="@style/Lead" />

            <TextView
                android:id="@+id/homeAlarmCount"
                style="@style/Body" />

            <Button
        style="@style/Button.Filled"
                android:id="@+id/btnHomeAlarmAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/alarm_add_button" />
        </LinearLayout>

        <!-- タイマー -->
        <LinearLayout
            android:id="@+id/homeTimerCard"
            style="@style/HomeCard">

            <LinearLayout style="@style/HomeCardHeader">

                <TextView
                    style="@style/HomeCardTitle"
                    android:drawableStart="@drawable/ic_timer"
                    android:text="@string/timer_widget" />

                <TextView
                    style="@style/HomeCardChevron" />
            </LinearLayout>

            <include layout="@layout/view_timer_panel" />
        </LinearLayout>

        <!-- ツールと設定 -->
        <LinearLayout
            android:id="@+id/homeToolsCard"
            style="@style/HomeCard">

            <LinearLayout style="@style/HomeCardHeader">

                <TextView
                    style="@style/HomeCardTitle"
                    android:drawableStart="@drawable/ic_tools"
                    android:text="@string/tools_title" />

                <TextView
                    style="@style/HomeCardChevron" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeToolsSummary"
                style="@style/Body"
                android:paddingBottom="0dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
