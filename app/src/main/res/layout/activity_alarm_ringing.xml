<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmRingingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <TextView
        android:id="@+id/alarmRingingTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="72sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmRingingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:textSize="22sp" />

    <Button
        style="@style/Button.Tonal.Large"
        android:id="@+id/btnAlarmSnooze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxl" />

    <Button
        style="@style/Button.Filled.Large"
        android:id="@+id/btnAlarmDismiss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/timer_stop" />
</LinearLayout>
