<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ringingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/timer_done_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ringingDuration"
        style="@style/Body"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:textSize="16sp" />

    <Chronometer
        android:id="@+id/ringingElapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:fontFeatureSettings="tnum"
        android:format="+%s"
        android:textSize="48sp" />

    <TextView
        style="@style/Body"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/timer_extend_label" />

    <LinearLayout
        android:id="@+id/ringingExtends"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <Button
        style="@style/Button.Filled.Large"
        android:id="@+id/btnRingingStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/timer_stop" />
</LinearLayout>
