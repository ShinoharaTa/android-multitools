<?xml version="1.0" encoding="utf-8"?>
<!-- タイマーの操作パネル。中身は TimerPanel が状態に応じて差し込む。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timerPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/timerPanelIdle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/timerPanelActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/timerPanelHeader"
            style="@style/Body"
            android:layout_width="wrap_content"
            android:paddingBottom="0dp" />

        <Chronometer
            android:id="@+id/timerPanelClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/timerPanelActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
