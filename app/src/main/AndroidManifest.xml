<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      WRITE_SECURE_SETTINGS は signature|privileged。通常のインストールでは付与されないので
      初回のみ adb shell pm grant で付与する。宣言していないと grant 自体が失敗する。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- SCREEN_OFF_TIMEOUT 用。設定アプリの「システム設定の変更」から許可する appop。 -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!--
      アラーム一覧を開くために必要。protection level は normal なのでインストール時に自動で付く。
      Galaxy 標準の時計アプリは SHOW_ALARMS の受け口 (AlarmCTSHandleActivity) を
      android:permission="com.android.alarm.permission.SET_ALARM" で保護しているため、
      これを宣言していないと SecurityException で弾かれ、何も起きないように見える。
      Google 時計は保護していないので、宣言なしでも開けてしまい気付きにくい。
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
      自前タイマー用。
      - USE_EXACT_ALARM: インストール時に自動で付く exact alarm 権限。SCHEDULE_EXACT_ALARM と違い
        本人の許可操作が要らない。Play では用途が制限されるが、ストア公開はしないので問題にならない。
      - FOREGROUND_SERVICE(_MEDIA_PLAYBACK): 鳴らしている間だけ動く前景サービス。
      - USE_FULL_SCREEN_INTENT: ロック中・画面オフのときに完了画面をそのまま開く。
      - POST_NOTIFICATIONS: 残り時間と鳴動の通知。実行時に許可を求める。
      - RECEIVE_BOOT_COMPLETED: 再起動中に消えたアラームを張り直す。
      - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: 最適化を外す確認ダイアログを出すため。
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Android 11+ のパッケージ可視性。時計アプリの解決と、ショートカットに置くアプリの
      一覧取得に必要。MAIN + LAUNCHER の intent を書けばランチャーに出るアプリが見えるので、
      制限付きの QUERY_ALL_PACKAGES は使わない。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.google.android.deskclock" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1. USB デバッグ ON/OFF -->
        <service
            android:name=".UsbDebugTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_usb_debug"
            android:label="@string/tile_usb_debug"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- 2. 画面タイムアウト切替 -->
        <service
            android:name=".ScreenTimeoutTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_screen_timeout"
            android:label="@string/tile_screen_timeout"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 3. アラーム画面を開く -->
        <service
            android:name=".AlarmTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_alarm"
            android:label="@string/tile_alarm"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".AlarmTargetActivity"
            android:exported="false"
            android:label="@string/alarm_target_title" />

        <activity
            android:name=".AppShortcutConfigActivity"
            android:exported="true"
            android:label="@string/shortcut_widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- アプリを開くショートカット。アプリの入れ替えにも追従させる。 -->
        <receiver
            android:name=".AppShortcutWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_app_shortcut_info" />
        </receiver>

        <!-- 次のアラームウィジェット。NEXT_ALARM_CLOCK_CHANGED は Android 8 以降の
             暗黙ブロードキャスト制限の例外なので、マニフェスト宣言の receiver で受けられる。 -->
        <receiver
            android:name=".NextAlarmWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_alarm_info" />
        </receiver>

        <!--
          タイマー。操作・発火・再起動はすべて TimerReceiver が受ける。
          外のアプリから止められないよう exported は false。BOOT_COMPLETED は system から
          届くので、exported でなくても受けられる。
        -->
        <receiver
            android:name=".TimerReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 鳴らしている間だけ動く。タイマーとアラームで共用。ロック解除前でも鳴らせるよう directBootAware。 -->
        <service
            android:name=".RingService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 完了画面。ロック画面の上に出し、他の画面の履歴には混ぜない。 -->
        <activity
            android:name=".TimerRingingActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <receiver
            android:name=".TimerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timer_info" />
        </receiver>

        <!--
          自前のアラーム。発火・スヌーズ・停止・ON/OFF・再起動・時刻変更をすべて AlarmReceiver が受ける。
          再起動直後のロック解除前でも張り直せるよう LOCKED_BOOT_COMPLETED を受け、directBootAware にする。
        -->
        <receiver
            android:name=".AlarmReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          アラーム一覧。SHOW_ALARMS も受けるので、アラームタイルの「開き先」でこのアプリを選べば
          ここに直行する。AlarmClock の javadoc に従い SET_ALARM で保護する。
          自動判定ではこのアプリを選ばない (Features.kt の Alarms.explicit)。
        -->
        <activity
            android:name=".AlarmListActivity"
            android:exported="true"
            android:label="@string/alarm_list_title"
            android:permission="com.android.alarm.permission.SET_ALARM">
            <intent-filter>
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AlarmEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AlarmRingingActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <receiver
            android:name=".AlarmWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_alarm_list_info" />
        </receiver>
    </application>
</manifest>
